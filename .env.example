# Required: clients send it as `Authorization: Bearer <key>`. Make one with: openssl rand -hex 32
IMAGEGEN_API_KEY=
KLEIN_PATH=~/models/flux-3-image-klein
# The prompt upsampler, for requests that send "upsample": true. Clients otherwise send full scene captions
# KLEIN_UPSAMPLER_PATH=~/models/flux-3-image-klein-pup
# KLEIN_DEVICE=auto
# bf16, int8 or fp8, quantized while loading. The transformer also takes fp8_dynamic: activations too, CUDA with FP8 support only
# TRANSFORMER_PRECISION=bf16
# TEXT_ENCODER_PRECISION=bf16
# CUDA beside another GPU process: the share of the card this server may hold, a render over it fails alone
# GPU_MEMORY_FRACTION=0.50
# HOST=127.0.0.1
# PORT=8741
# PRELOAD=klein
# MAX_QUEUED=64
# TASK_TTL=3600
# DB_PATH=data/imagegen.sqlite3
